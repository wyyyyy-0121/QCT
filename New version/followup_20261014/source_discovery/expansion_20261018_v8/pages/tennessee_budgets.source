025/03/WARyeGHaySquare.pdf">Ryegrass</a></td><td><a href="https://arec.tennessee.edu/wp-content/uploads/sites/17/2025/03/WARyegrassPasture.pdf">Ryegrass</a></td><td><a href="https://arec.tennessee.edu/wp-content/uploads/sites/17/2025/03/WARyeGBal.pdf">Ryegrass</a></td></tr><tr><td><a href="https://arec.tennessee.edu/wp-content/uploads/sites/17/2025/03/WATritHayRound.pdf">Triticale</a></td><td><a href="https://arec.tennessee.edu/wp-content/uploads/sites/17/2025/03/WATritHaySquare.pdf">Triticale</a></td><td><a href="https://arec.tennessee.edu/wp-content/uploads/sites/17/2025/03/WATritPasture.pdf">Triticale</a></td><td><a href="https://arec.tennessee.edu/wp-content/uploads/sites/17/2025/03/WATritBal.pdf">Triticale</a></td></tr><tr><td><a href="https://arec.tennessee.edu/wp-content/uploads/sites/17/2025/03/WAWheatHayRound.pdf">Wheat</a></td><td><a href="https://arec.tennessee.edu/wp-content/uploads/sites/17/2025/03/WAWheatHaySquare.pdf">Wheat</a></td><td><a href="https://arec.tennessee.edu/wp-content/uploads/sites/17/2025/03/WAWheatPasture.pdf">Wheat</a></td><td><a href="https://arec.tennessee.edu/wp-content/uploads/sites/17/2025/03/WAWheatBal.pdf">Wheat</a></td></tr></tbody></table></figure>



