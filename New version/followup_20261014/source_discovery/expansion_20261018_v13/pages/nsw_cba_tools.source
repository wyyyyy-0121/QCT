="(min-width: 1024px)" type="image/jpeg" width="768" height="432"/><source srcset="/sites/default/files/styles/hero_m_x1/public/2025-04/nsw-treasury-e-learning.jpeg?itok=sxHnMZ0e 1x, /sites/default/files/styles/hero_m_x2/public/2025-04/nsw-treasury-e-learning.jpeg?itok=KH56nwfU 2x" media="(min-width: 768px)" type="image/jpeg" width="650" height="366"/><source srcset="/sites/default/files/styles/hero_s_x1/public/2025-04/nsw-treasury-e-learning.jpeg?itok=xKpFEjC1 1x, /sites/default/files/styles/hero_s_x2/public/2025-04/nsw-treasury-e-learning.jpeg?itok=XRJnWHvn 2x" media="(min-width: 480px)" type="image/jpeg" width="767" height="431"/><source srcset="/sites/default/files/styles/hero_xs_x1/public/2025-04/nsw-treasury-e-learning.jpeg?itok=fwP6c_tf 1x, /sites/default/files/styles/hero_xs_x2/public/2025-04/nsw-treasury-e-learning.jpeg?itok=HwexvluC 2x" type="image/jpeg" width="479" height="269"/><img loading="eager" width="768" height="432" src="/sites/default/files/styles/hero_l_x1/public/2025-04/nsw-treasury-e-learning.jpeg?itok=dLKMNEnW" alt="e-book technology on a virtual screen." /></picture>
