.lbox {

  margin: 0 auto;
  position: relative;
  display: block;
  overflow: hidden;
}

.lbox__line {
  position: absolute;
}

.lbox__line:nth-child(1),
.lbox__line:nth-child(3) {
  width: 100%;
  height: 2px;
}

.lbox__line:nth-child(2),
.lbox__line:nth-child(4) {
  width: 2px;
  height: 100%;
}

.lbox__line:nth-child(1) {
  top: 0;
  left: 0;
  background: linear-gradient(to right, transparent, #B5CBE0);
  animation: animate1 12s linear infinite;

}



.lbox__line:nth-child(2) {
  top: 0;
  right: 0;
  animation: animate2 12s linear infinite;
  animation-delay: 4s;
  background: linear-gradient(to bottom, transparent, #B5CBE0);
}


.lbox__line:nth-child(3) {
  bottom: 0;
  left: 0;
  background: linear-gradient(to left, transparent, #B5CBE0);
  animation: animate3 12s linear infinite;
  animation-delay: 6s;
}


.lbox__line:nth-child(4) {
  top: 0;
  left: 0;
  background: linear-gradient(to top, transparent, #B5CBE0);
  animation: animate4 12s linear infinite;
  animation-delay: 10s;
}


@keyframes animate1 {

  0% {
    transform: translateX(-100%);
  }

  100% {
    transform: translateX(200%);
  }
}

@keyframes animate2 {

  0% {
    transform: translateY(-100%);
  }

  100% {
    transform: translateY(500%);
  }

}

@keyframes animate3 {


  0% {
    transform: translateX(100%);
  }

  100% {
    transform: translateX(-200%);
  }

}

@keyframes animate4 {


  0% {
    transform: translateY(100%);
  }


  100% {
    transform: translateY(-500%);
  }

}

-->
