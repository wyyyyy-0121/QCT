		document.addEventListener( 'click', function( e ) {
			var el = e.target && e.target.closest( '[data-gb-share-url]' );
			if ( ! el ) { return; }
			e.preventDefault();
			genesisBlocksShare( el.getAttribute( 'data-gb-share-url' ), el.getAttribute( 'data-gb-share-label' ) || '', '600', '600' );
		} );
	</script>
