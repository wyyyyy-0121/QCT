<script id="breeze-prefetch-js" src="https://peri.umass.edu/wp-content/plugins/breeze/assets/js/js-front-end/breeze-prefetch-links.min.js?ver=2.6.1"></script>
<script id="theme-script-js-extra">
var themeVariables = {"templateUrl":"https://peri.umass.edu/wp-content/themes/peri"};
//# sourceURL=theme-script-js-extra
</script>
<script id="theme-script-js" src="https://peri.umass.edu/wp-content/themes/peri/assets/js/script.js?ver=1773229121"></script>
<script type="speculationrules">
{"prefetch":[{"source":"document","where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":["/wp-*.php","/wp-admin/*","/wp-content/uploads/*","/wp-content/*","/wp-content/plugins/*","/wp-content/themes/peri/*","/*\\?(.+)"]}},{"not":{"selector_matches":"a[rel~=\"nofollow\"]"}},{"not":{"selector_matches":".no-prefetch, .no-prefetch a"}}]},"eagerness":"conservative"}]}
</script>
<script>
	var relevanssi_rt_regex = /(&|\?)_(rt|rt_nonce)=(\w+)/g
	var newUrl = window.location.search.replace(relevanssi_rt_regex, '')
	if (newUrl.substr(0, 1) == '&') {
		newUrl = '?' + newUrl.substr(1)
	}
	history.replaceState(null, null, window.location.pathname + newUrl + window.location.hash)
</script>
</body>
</html>
