.img-right{float:right;width:50%;margin:1em 0 1em 1em;}
@media (max-width:550px){
.img-right{float:none;width:100%;margin:1em 0;}
}
</style>	

<style>
.itemtitle .note {font-weight:normal;text-align:left;}
.morebtn {text-align:center;}
div.category-list {padding:1.5em 0 1em 1em;background:#f9f9f9;clear:both;position:relative;}
.category-list .header {display:block;position:absolute;left:-5px;top:-5px;z-index:999;font-size:0.8em;background:#eee;color:#555;padding:3px 30px 3px 10px;}
.category-list ul {margin:0;padding:0;list-style:none;}
.category-list li {float:left;display:block;width:33%;text-align:left;}
.category-list a {text-decoration:none;}
.category-list a:hover {text-decoration:underline;}
</style>
